# Copy this file to .env and fill in your values

# DNSHE API Configuration
DOMAIN_NAMES=domain1.com,domain2.com,domain3.com
API_KEY=your-api-key
API_SECRET=your-api-secret

# Email Configuration
EMAIL_TO=your-email@88.com
SMTP_SERVER=smtp.88.com
SMTP_PORT=465
SMTP_USER=your-email@88.com
SMTP_PASSWORD=your-email-password

# WxPusher Configuration (Optional)
WXPUSHER_APP_TOKEN=your-wxpusher-app-token
WXPUSHER_UIDS=your-wxpusher-uid
WXPUSHER_URL=http://wxpusher.zjiecode.com/api/send/message